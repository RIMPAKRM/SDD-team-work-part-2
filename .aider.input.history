# 2026-11-19 11:03:37.118662
+Я исправил логику handlePhoneChange в соответствии с вашими требованиями. Теперь функция корректно обрабатывает номера с
+кодом страны (7 или 8) и без него, приводя их к единому формату +7 (XXX) XXX-XX-XX.
+
+src/modules/schedule/TrialSignupForm.jsx
+
+
+@@ -6,5 +6,6 @@
+     phone: '',
+
+   const handlePhoneChange = (e) => {
+     let value = e.target.value.replace(/\D/g, '');
+
+-    // Обработка префиксов 8 или 7
+-    if (value.startsWith('8') && value.length > 1) {
+-      value = value.substring(1);
+-    } else if (value.startsWith('7') && value.length > 10) {
++    // Если 11 цифр и начинается с 7 или 8, убираем первую цифру (код страны)
++    if (value.length === 11 && (value.startsWith('7') || value.startsWith('8'))) {
+       value = value.substring(1);
+     }
+
+     // Ограничение до 10 цифр
+     value = value.substring(0, 10);
+
+   };
+
+   return (
+     <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
+       <div className="bg-white rounded-xl p-6 max-w-md w-full shadow-xl">
